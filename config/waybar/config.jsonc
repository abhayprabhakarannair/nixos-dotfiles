// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top", // ✨ Moved to the top edge
    "height": 42,
    "spacing": 4,

    "modules-left": [
        "custom/nixos", // 🛠️ Renamed from custom/arch to custom/nixos
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "language",
        "battery",
        "battery#bat2",
        "clock"
    ],

    "include": [
        "~/.config/waybar/modules.jsonc"
    ]
}
